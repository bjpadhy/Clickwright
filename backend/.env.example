# ── ClickHouse Cloud ────────────────────────────────────────────
# From the ClickHouse Cloud console → Connect → HTTPS
CLICKHOUSE_URL=https://xxxxx.region.clickhouse.cloud:8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default

# ── Langfuse (use Langfuse Cloud so the whole team + judges can view traces) ──
LANGFUSE_PUBLIC_KEY=pk-lf-
LANGFUSE_SECRET_KEY=sk-lf-
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ── LLM ─────────────────────────────────────────────────────────
# Backend precedence: LLM_PROVIDER if set → a real GEMINI_API_KEY → a real
# ANTHROPIC_API_KEY → the Claude Agent SDK (your machine's Claude Code login).
# LLM_PROVIDER: gemini | anthropic | anthropic-oauth (blank = auto by key)
LLM_PROVIDER=

# Google Gemini via the OpenAI-compatible endpoint. Free key: Google AI Studio →
# "Get API key" (no card). Free tier ≈ 15 requests/min, 1,500/day — one question
# is 5–7 calls. Note: Google may use free-tier prompts to improve its models; the
# pipeline sends schema, SQL and aggregates, never user PII.
#
# GEMINI_MODEL matters: the newest models can ship with a far lower free-tier
# DAILY cap (measured 21 Sep 2026: gemini-3.8-flash allows 20 requests/day, which
# one question exhausts). gemini-3.1-flash-lite is the default here — 1.2–1.5 s
# per call on the normal quota. If runs die in rate-limit retries, change it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Any OpenAI-compatible host works here (default: Gemini's endpoint).
LLM_BASE_URL=

# Direct Anthropic API (leave the placeholder to use the Claude Code login instead).
ANTHROPIC_API_KEY=sk-ant-
CLICKWRIGHT_MODEL=claude-sonnet-5

# Transport: in-flight calls process-wide (3 fits the Gemini free tier; the Claude
# Code path defaults to 8), per-attempt timeout, and optional OpenAI-path fields
# that are only sent when set (Gemini rejects unknown fields with a 400).
LLM_MAX_CONCURRENCY=3
LLM_TIMEOUT_MS=240000
# Thinking budget on the Gemini path. Defaults to "low" in code and you should
# leave it there: measured on the coupon question, "none" answered 30.3% and an
# independent query disagreed (confidence low 0.14), while "low" answered 27.6%
# and was reproduced to the digit (high 0.79). Costs ~10 s per question.
LLM_REASONING_EFFORT=low
LLM_SEED=

# ── Analytics escape hatches (all ON by default; set to 0 to disable) ──
# Each one trades a little answer texture for seconds of latency. Disable only
# if a demo needs the last few seconds.
ANALYTICS_QUALITY_GATE=1        # LLM quality gate + narration revision pass
ANALYTICS_LLM_LOOKUP=1          # LLM knowledge lookup (0 = deterministic term match only)
ANALYTICS_RELATED_INSIGHTS=1    # related cached insights in the narrator prompt
ANALYTICS_ORDER_BY_ALL=1        # ORDER BY ALL before the fetch cap (needs ClickHouse ≥ 23.12)
